from collections.abc import Iterator
from typing import ClassVar

class TaggedLemma:
    lemma: str
    tag: str

class TaggedLemmas:
    def __init__(self) -> None: ...
    def __len__(self) -> int: ...
    def __getitem__(self, index: int) -> TaggedLemma: ...
    def __iter__(self) -> Iterator[TaggedLemma]: ...

class Morpho:
    NO_GUESSER: ClassVar[int]
    @staticmethod
    def load(path: str) -> Morpho | None: ...
    def analyze(self, form: str, guesser: int, lemmas: TaggedLemmas) -> int: ...
    def rawLemma(self, lemma: str) -> str: ...
